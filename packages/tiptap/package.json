{
  "name": "tiptap-extension-gallery-layout",
  "version": "1.0.4",
  "description": "Tiptap extension for gallery-layout",
  "type": "module",
  "keywords": [
    "gallery",
    "layout",
    "image-gallery",
    "tiptap",
    "tiptap-extension",
    "rich-text",
    "editorial-layout"
  ],
  "homepage": "https://gallery-layout-playground.vercel.app/",
  "repository": "https://github.com/gilangabdian/gallery-layout.git",
  "author": "Gilang Abdian",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "gallery-layout": "workspace:*"
  },
  "peerDependencies": {
    "@tiptap/core": "^2.0.0"
  },
  "devDependencies": {
    "@tiptap/core": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}