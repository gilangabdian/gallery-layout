{
  "name": "gallery-layout-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm -r build",
    "test:run": "pnpm -r test:run",
    "typecheck": "pnpm -r typecheck",
    "lint": "prettier --check .",
    "lint-fix": "prettier --write .",
    "verify": "pnpm --filter gallery-layout build && pnpm lint && pnpm typecheck && pnpm test:run",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm publish -r --access public --provenance --no-git-checks"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,css,json,md,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
